{
  "name": "metalsmith-canonical",
  "version": "1.2.0",
  "description": "A metalsmith plugin to add a canonical url property to pages",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test nyc --reporter=text-summary mocha --recursive --throw-deprecation",
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "standard-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saintedlama/metalsmith-canonical.git"
  },
  "keywords": [
    "metalsmith",
    "seo",
    "canonical"
  ],
  "author": "Christoph Walcher <christoph.walcher@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/saintedlama/metalsmith-canonical/issues"
  },
  "homepage": "https://github.com/saintedlama/metalsmith-canonical#readme",
  "dependencies": {
    "lodash": "^4.18.1",
    "multimatch": "^8.0.0",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "coveralls": "^3.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "metalsmith": "^2.7.0",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "standard-version": "^9.5.0"
  }
}
